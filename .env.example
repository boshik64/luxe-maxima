DATABASE_URL=postgresql://luxe:luxe@localhost:5432/luxe_maxima
AUTH_SECRET=replace-with-long-random-string

ADMIN_EMAIL=admin@karofilm.ru
ADMIN_PASSWORD=changeme
OPERATOR_EMAIL=operator@karofilm.ru
OPERATOR_PASSWORD=changeme

KARO_API_URL=https://api.karofilm.ru
# Локально: http://localhost:3000
# Прод: https://event.karofilm.ru  (ссылки «Открыть в админке» в письмах)
APP_URL=https://event.karofilm.ru

# Тема публичной части: autumn (по умолчанию) или classic
NEXT_PUBLIC_SITE_THEME=autumn

# Рассылка (пример КАРО: STARTTLS на 587, auth может быть пустым)
SMTP_HOST=mail.karofilm.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=karoevent@karofilm.ru
# Входящая почта для чата по заявкам (предпочтительно EWS — на KARO IMAP с сервера закрыт)
EWS_URL=https://mail.karofilm.ru/EWS/Exchange.asmx
EWS_USER=karoevent@karofilm.ru
EWS_PASSWORD=
# EWS_AUTH=basic|ntlm  (по умолчанию: basic, при 401 — NTLM)
# EWS_TLS_INSECURE=1   (если корпоративный сертификат не доверяется)
# Запасной вариант, если IMAP когда-нибудь откроют:
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
CRON_SECRET=
# Письма сотрудникам: галочки в карточке пользователя (/admin/users)
# Опционально: MAILBOX_SMTP=1 — RCPT-проверка ящика (часто ломает корп. почту)
