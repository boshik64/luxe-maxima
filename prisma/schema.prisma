generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  CLOSED
  REJECTED
}

enum ProductId {
  keys
  group
  event
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HallFormat {
  id        String   @id @default(uuid())
  name      String   @unique
  benefits  String[]
  imageUrl  String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  halls     Hall[]
}

model RentalCinema {
  id           String   @id @default(uuid())
  karoCinemaId String   @unique
  name         String
  cityId       String
  cityName     String
  address      String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  halls        Hall[]

  @@index([cityId, enabled])
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Hall {
  id                   String        @id @default(uuid())
  name                 String
  capacity             Int
  rentalPriceWeekday   Int
  rentalPriceWeekend   Int
  enabled              Boolean       @default(true)
  cinemaId             String
  cinema               RentalCinema  @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  formatId             String
  format               HallFormat    @relation(fields: [formatId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([cinemaId, formatId])
}

model Application {
  id              String             @id @default(uuid())
  productId       ProductId
  status          ApplicationStatus  @default(NEW)
  source          String
  cityId          String?
  cityName        String
  cinemaId        String?
  cinemaName      String
  hallId          String?
  hallName        String?
  hallFormatName  String?
  hallCapacity           Int?
  hallRentalPrice        Int?
  hallRentalPriceWeekday Int?
  hallRentalPriceWeekend Int?
  filmId          String?
  filmName        String?
  watchCustom     String?
  sessionId       String?
  sessionLabel    String?
  sessionCustom   String?
  rentalDate      String?
  rentalTime      String?
  rentalDuration  String?
  rentalStart     String?
  rentalEnd       String?
  guests          Int?
  ticketType      String?
  contactName     String
  phone           String
  email           String
  comment         String?
  adminComment    String?
  consent         Boolean
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  idempotencyKey  String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([productId, createdAt])
}

model Feedback {
  id             String          @id @default(uuid())
  status         FeedbackStatus  @default(NEW)
  name           String
  email          String
  phone          String?
  topic          String
  message        String
  consent        Boolean
  adminComment   String?
  source         String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
}

model SiteBanner {
  id        String   @id @default(uuid())
  slot      String   @unique
  imageUrl  String
  href      String?
  alt       String   @default("")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarouselSettings {
  id              String   @id @default("default")
  intervalSeconds Int      @default(6)
  updatedAt       DateTime @updatedAt
}

model CarouselSlide {
  id        String   @id @default(uuid())
  kicker    String   @default("")
  title     String
  body      String   @default("")
  ctaLabel  String   @default("")
  ctaHref   String   @default("#form")
  imageUrl  String
  alt       String   @default("")
  layout    String   @default("image-left")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}
